#!/usr/bin/env python3
"""
Diagnostic script for P&L Command Center Streamlit app
Checks data loading, cache, and common issues
"""

import sys
from pathlib import Path
import json

print("=" * 80)
print("P&L COMMAND CENTER — DIAGNOSTIC CHECK")
print("=" * 80)

# 1. Check if data_loader exists and is correct
print("\n[1] Checking data_loader.py...")
loader_path = Path("data_loader.py")
if not loader_path.exists():
    print("❌ data_loader.py NOT FOUND")
    print("   → Copy data_loader_fixed.py to data_loader.py")
else:
    print("✅ data_loader.py exists")
    # Check for the fix (look for _ensure_derived_cols function)
    content = loader_path.read_text()
    if "_ensure_derived_cols" in content:
        print("✅ Has _ensure_derived_cols function (FIXED version)")
    else:
        print("⚠️  Missing _ensure_derived_cols (OLD version, needs update)")

# 2. Check if app.py exists
print("\n[2] Checking app.py...")
app_path = Path("app.py")
if not app_path.exists():
    print("❌ app.py NOT FOUND")
    print("   → Copy app_fixed.py to app.py")
else:
    print("✅ app.py exists")
    content = app_path.read_text()
    if "CACHE_FILE = DATA_DIR" in content and "CACHE_FILE.unlink()" in content:
        print("✅ Has fix #1 (cache clearing)")
    else:
        print("⚠️  Missing fix #1 (cache clearing)")

# 3. Check cache status
print("\n[3] Checking cache files...")
cache_dir = Path("data")
cache_file = cache_dir / "gl_cache.parquet"
meta_file = cache_dir / "uploaded_files.json"

if cache_dir.exists():
    print(f"✅ Cache directory exists: {cache_dir}")
    if cache_file.exists():
        print(f"⚠️  Cache file exists: {cache_file} ({cache_file.stat().st_size} bytes)")
        print("   → If app is blank, try deleting this file")
    else:
        print("✅ No cache file (fresh state)")
    
    if meta_file.exists():
        print(f"⚠️  Metadata file exists: {meta_file}")
        try:
            meta = json.loads(meta_file.read_text())
            files = meta.get("files", [])
            print(f"   → Contains {len(files)} uploaded file(s)")
            for f in files[:3]:
                print(f"     • {f.get('filename')} ({f.get('rows', 0):,} rows)")
        except Exception as e:
            print(f"   → Error reading metadata: {e}")
    else:
        print("✅ No metadata file (fresh state)")
else:
    print("✅ No cache directory (fresh state)")

# 4. Check current working directory
print("\n[4] Checking directory structure...")
cwd = Path.cwd()
print(f"Working directory: {cwd}")
print("Files present:")
for f in sorted(cwd.glob("*")):
    if f.is_file() and f.name.endswith(".py"):
        print(f"  • {f.name}")

# 5. Check for import errors
print("\n[5] Testing imports...")
try:
    import streamlit
    print(f"✅ streamlit {streamlit.__version__}")
except ImportError as e:
    print(f"❌ streamlit import failed: {e}")

try:
    import pandas
    print(f"✅ pandas {pandas.__version__}")
except ImportError as e:
    print(f"❌ pandas import failed: {e}")

try:
    import plotly
    print(f"✅ plotly {plotly.__version__}")
except ImportError as e:
    print(f"❌ plotly import failed: {e}")

try:
    from data_loader import load_all_data
    print("✅ Can import load_all_data from data_loader")
except ImportError as e:
    print(f"❌ Cannot import data_loader: {e}")

# 6. Summary & recommendations
print("\n" + "=" * 80)
print("RECOMMENDATIONS")
print("=" * 80)

issues = []

if not loader_path.exists():
    issues.append("1. Copy data_loader_fixed.py to data_loader.py")
if not app_path.exists():
    issues.append("2. Copy app_fixed.py to app.py")
if cache_file.exists():
    issues.append("3. Delete cache file: data/gl_cache.parquet")
if meta_file.exists():
    issues.append("4. Delete metadata file: data/uploaded_files.json")

if issues:
    print("\nIssues found. Try these steps:")
    for issue in issues:
        print(f"  {issue}")
    print("\n5. Restart Streamlit: streamlit run app.py")
else:
    print("\n✅ No obvious issues found.")
    print("\nIf app is still blank:")
    print("  1. Check the terminal for error messages")
    print("  2. Try uploading a GL data file (CSV or Excel)")
    print("  3. If still blank, delete data/ folder and restart")

print("\n" + "=" * 80)
